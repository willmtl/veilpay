// VeilPay: Confidential Capital Allocation & Verifiable Selective Disclosure Protocol
// Written in Midnight Compact Language v0.14+
// Network: Midnight Network (Dual-Ledger Zero-Knowledge State Model)

pragma compact 0.14.0;

import CompactStandardLibrary;

// =========================================================================
// SECTION 1: PUBLIC CONSENSUS LEDGER STATE (On-Chain)
// =========================================================================

export ledger {
    // Total aggregate liquidity deposited in the vault (publicly auditable)
    vaultBalance: Uint<64>,

    // Total accumulated liquid staking yield generated by idle capital
    accruedYieldBalance: Uint<64>,

    // Current Merkle root of active cohort commitments: Poseidon(pk, amount, epoch, salt)
    commitmentRoot: Bytes<32>,

    // Global registry of consumed nullifiers to prevent double-spending
    spentNullifiers: Set<Bytes<32>>,

    // Active epoch identifier (pay period, grant cycle, or campaign epoch)
    currentEpoch: Uint32,

    // Authorized controller public key (employer treasury, grant committee)
    controllerPublicKey: Bytes<32>,

    // Last block epoch when idle yield was harvested
    lastHarvestEpoch: Uint32
}

// =========================================================================
// SECTION 2: PRIVATE CLIENT WITNESS DECLARATIONS (Local Prover)
// =========================================================================

// Witness inputs provided locally by beneficiary's Lace wallet / client
witness BeneficiaryWitness {
    secretKey: Bytes<32>,
    allocationAmount: Uint<64>,
    blindingSalt: Bytes<32>,
    merklePath: Vector<Bytes<32>, 16>,
    leafIndex: Uint16,
    personalYieldAccrual: Uint64
}

// Witness for landlord / lender income attestation
witness AttestationWitness {
    secretKey: Bytes<32>,
    historicalClaims: Vector<Uint<64>, 6>,
    allocationAmount: Uint<64>
}

// =========================================================================
// SECTION 3: CORE COMPACT CIRCUITS
// =========================================================================

/**
 * CIRCUIT 1: fund_payroll_pool
 * Allows authorized employers, DAOs, or campaign sponsors to fund the pool
 * and commit a new Merkle tree of confidential recipient allocations.
 */
export circuit fund_payroll_pool(
    batchCommitmentRoot: Bytes<32>,
    depositAmount: Uint<64>,
    targetEpoch: Uint32
): [] {
    // 1. Enforce strictly positive deposit
    assert(depositAmount > 0, "VeilPay: Deposit amount must be strictly positive");
    
    // 2. Increment public vault balance
    vaultBalance = vaultBalance + depositAmount;

    // 3. Update public consensus state with the new Merkle commitment root
    commitmentRoot = batchCommitmentRoot;
    currentEpoch = targetEpoch;

    // 4. Delegate idle liquidity into Midnight/Cardano liquid staking contract
    // The funds earn yield while waiting for beneficiaries to claim.
    lastHarvestEpoch = targetEpoch;
}

/**
 * CIRCUIT 2: claim_disbursement_with_split
 * Beneficiaries execute confidential claims client-side. The circuit proves
 * membership in the commitment tree, derives a deterministic nullifier, and
 * atomically routes payouts across up to 3 unlinked stealth addresses.
 */
export circuit claim_disbursement_with_split(
    // Public Inputs (Broadcast to consensus)
    nullifier: Bytes<32>,
    destinations: Vector<Address, 3>,
    splitAmounts: Vector<Uint<64>, 3>
): [] {
    // Acquire private witness variables from client wallet
    witness w: BeneficiaryWitness;

    // 1. Compute commitment leaf: C = Poseidon(PublicKey(sk), amount, epoch, salt)
    val pk = derivePublicKey(w.secretKey);
    val computedLeaf = poseidonHash(pk, w.allocationAmount, currentEpoch, w.blindingSalt);

    // 2. Verify cryptographic inclusion in the public commitment root
    val isValidInclusion = verifyMerklePath(commitmentRoot, computedLeaf, w.merklePath, w.leafIndex);
    assert(isValidInclusion, "VeilPay: Cryptographic Merkle membership proof failed");

    // 3. Derive deterministic nullifier: N = Poseidon(secretKey, epoch)
    val expectedNullifier = poseidonHash(w.secretKey, currentEpoch);
    assert(expectedNullifier == nullifier, "VeilPay: Nullifier derivation mismatch");

    // 4. Double-spend prevention: Assert nullifier has never been consumed
    assert(!spentNullifiers.contains(nullifier), "VeilPay: Replay attack detected — nullifier already spent");

    // 5. Conservation of value assertion: Sum of stealth splits <= allocation + yield bonus
    val totalSplit = splitAmounts[0] + splitAmounts[1] + splitAmounts[2];
    assert(totalSplit <= (w.allocationAmount + w.personalYieldAccrual), "VeilPay: Split payouts exceed allowed allocation");

    // 6. Solvency check on consensus vault
    assert(vaultBalance >= totalSplit, "VeilPay: Insufficient vault liquidity");

    // 7. Mutate consensus state: consume nullifier and deduct vault balance
    spentNullifiers.insert(nullifier);
    vaultBalance = vaultBalance - totalSplit;

    // 8. Execute atomic disbursements to unlinked stealth destinations
    // Observers see 3 payments with zero cryptographic correlation or employer link.
    send(destinations[0], splitAmounts[0]);
    send(destinations[1], splitAmounts[1]);
    send(destinations[2], splitAmounts[2]);
}

/**
 * CIRCUIT 3: harvest_idle_yield
 * Periodically harvests accumulated liquid staking rewards from the idle pool
 * and updates public consensus accounting.
 */
export circuit harvest_idle_yield(
    minRewardThreshold: Uint<64>
): [] {
    // 1. Calculate yield accrued from Cardano/Midnight staking contracts
    val calculatedYield = calculateStakingRewards(vaultBalance, lastHarvestEpoch, currentEpoch);
    assert(calculatedYield >= minRewardThreshold, "VeilPay: Accrued yield below harvest threshold");

    // 2. Accrue to public yield reserve
    accruedYieldBalance = accruedYieldBalance + calculatedYield;
    lastHarvestEpoch = currentEpoch;
}

/**
 * CIRCUIT 4: disclose_income_attestation
 * Allows a worker to prove to a third party (landlord, mortgage lender, auditor)
 * that their annual income meets or exceeds a public threshold, with ZERO data
 * leaked about their exact salary, employer, or liquid savings balance.
 */
export circuit disclose_income_attestation(
    publicIncomeThreshold: Uint<64>,
    recipientAuditorAddress: Address
): [attestationSignature: Bytes<64>] {
    // Acquire private witness variables
    witness aw: AttestationWitness;

    // 1. Verify caller owns a valid private key associated with past commitments
    val pk = derivePublicKey(aw.secretKey);
    assert(pk != 0, "VeilPay: Invalid secret key witness");

    // 2. Assert annualized income is strictly greater than or equal to threshold
    val annualizedSalary = aw.allocationAmount * 12;
    assert(annualizedSalary >= publicIncomeThreshold, "VeilPay: Income fails threshold attestation");

    // 3. Issue zero-knowledge attestation signature bound to threshold and auditor address
    return zkAttestSign(publicIncomeThreshold, recipientAuditorAddress, currentEpoch);
}
